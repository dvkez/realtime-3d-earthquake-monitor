# ==========================================
# Realtime 3D Earthquake Monitor - Environment Variables
# ==========================================
# This project consumes the official USGS Earthquake API (Public & Open Data).
# No API key is required for basic live earthquake feeds.
#
# If you plan to extend this app with third-party providers (e.g., Mapbox, custom analytics, Sentry):
# 1. Copy this file to .env.local:
#    cp .env.example .env.local
# 2. Add your custom keys below.

# Example optional analytics or monitoring
# NEXT_PUBLIC_ANALYTICS_ID=
# NEXT_PUBLIC_MAPBOX_TOKEN=
